<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_greeting" targetNamespace="https://fastbpmn.dev/examples" exporter="Camunda Modeler" exporterVersion="5.38.1">
  <process id="GreetingProcess" name="Greeting process" isExecutable="true">
    <startEvent id="StartEvent" name="Start" />
    <serviceTask xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="BuildGreeting" name="Build greeting" camunda:type="external" camunda:topic="build-greeting" />
    <serviceTask xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Shoutout" name="Shout out greeting" camunda:type="external" camunda:topic="greet" />
    <endEvent id="EndEvent" name="Done" />
    <sequenceFlow id="Flow_Start_Build" sourceRef="StartEvent" targetRef="BuildGreeting" />
    <sequenceFlow id="Flow_Build_Shoutout" sourceRef="BuildGreeting" targetRef="Shoutout" />
    <sequenceFlow id="Flow_Shoutout_End" sourceRef="Shoutout" targetRef="EndEvent" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Greeting">
    <bpmndi:BPMNPlane id="Plane_Greeting" bpmnElement="GreetingProcess">
      <bpmndi:BPMNShape id="Shape_StartEvent" bpmnElement="StartEvent">
        <dc:Bounds x="120" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BuildGreeting" bpmnElement="BuildGreeting">
        <dc:Bounds x="220" y="78" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Shoutout" bpmnElement="Shoutout">
        <dc:Bounds x="430" y="78" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent" bpmnElement="EndEvent">
        <dc:Bounds x="600" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Start_Build" bpmnElement="Flow_Start_Build">
        <di:waypoint x="156" y="118" />
        <di:waypoint x="220" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Build_Shoutout" bpmnElement="Flow_Build_Shoutout">
        <di:waypoint x="340" y="118" />
        <di:waypoint x="430" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Shoutout_End" bpmnElement="Flow_Shoutout_End">
        <di:waypoint x="550" y="118" />
        <di:waypoint x="600" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
